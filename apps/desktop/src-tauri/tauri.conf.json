{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workforce",
  "version": "0.1.0",
  "identifier": "om.workforce.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist",
    "beforeDevCommand": "bun run --filter @mms/web dev",
    "beforeBuildCommand": "bun run --filter @mms/web build"
  },
  "app": {
    "windows": [
      {
        "title": "Workforce",
        "width": 1366,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:3000 https://*.amazonaws.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    }
  }
}
